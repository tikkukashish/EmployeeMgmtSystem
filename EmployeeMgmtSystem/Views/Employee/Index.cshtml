@model IEnumerable<EmployeeMgmtSystem.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

@* @{
    var Employee = ViewData["Employees"] as list<Employee>;
} *@

@{
    var Employee = ViewBag.Employees;
}

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

            <h3 class="mb-0">Employee Management System</h3>

            <a asp-action="Create" class="btn btn-light rounded-pill">
                + Add Employee
            </a>

        </div>

        <div class="card-body">

            <form asp-action="Index" method="post" class="row mb-4">

                <div class="col-md-9">
                    <input type="text"
                           name="search"
                           class="form-control form-control-lg rounded-pill"
                           placeholder="🔍 Search employee..." />
                </div>

                <div class="col-md-3">
                    <button type="submit"
                            class="btn btn-primary btn-lg rounded-pill w-100">
                        Search
                    </button>
                </div>

            </form>

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>@Html.DisplayNameFor(model => model.EmpName)</th>
                            <th>@Html.DisplayNameFor(model => model.mobile)</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var emp in Employee)
                        {
                            <tr>

                                <td>@emp.EmpName</td>

                                <td>@emp.mobile</td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@emp.EmpId"
                                       class="btn btn-warning btn-sm rounded-pill me-1">
                                        Edit
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@emp.EmpId"
                                       class="btn btn-info btn-sm rounded-pill text-white me-1">
                                        Details
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@emp.EmpId"
                                       class="btn btn-danger btn-sm rounded-pill">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>